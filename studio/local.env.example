# python3 scripts/init_env.py génère les valeurs dans .env (mode 0600).
DJANGO_SECRET_KEY=
STUDIO_DB_PASSWORD=
POSTGRES_PASSWORD=
# Port web sur 127.0.0.1
STUDIO_PORT=8000
# Origine HTTPS du portail externe ou valeur locale déduite de STUDIO_PORT.
STUDIO_PORTAL_ORIGIN=
# Canal vérifié pour les questions sur les dépôts et les demandes d’effacement.
STUDIO_PORTAL_CONTACT=
